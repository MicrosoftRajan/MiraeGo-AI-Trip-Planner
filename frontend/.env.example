# Clerk (required on Vercel)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend (either style works)
# VITE_API_URL=https://miraego-ai-trip-planner.onrender.com/api
# VITE_API_BASE_URL=https://miraego-ai-trip-planner.onrender.com
#
# Local `npm run dev`: leave both empty (Vite proxy).
# Vercel: set VITE_API_URL as above, OR rely on vercel.json rewrites.
VITE_API_URL=

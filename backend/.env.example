PORT=5001
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/miraego?appName=Cluster0

# Primary LLM — Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000

# Secondary LLM — Groq (preferred when set)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=60000

# Secondary LLM — OpenRouter (used when Groq is not configured)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Gilora

# Cascade retry / exponential backoff
# retries=1 means: initial attempt + one retry per LLM tier
LLM_RETRIES=1
LLM_BACKOFF_BASE_MS=500
LLM_BACKOFF_MAX_MS=8000
